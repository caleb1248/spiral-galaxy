   <direction>
    <direction-type>
     <rehearsal default-x="77" font-style="normal" font-size="14.8553" font-weight="bold" color="#000000" enclosure="square">A</rehearsal>
    </direction-type>
    <voice>1</voice>
    <staff>1</staff>
   </direction>
   <direction>
    <direction-type>
     <words default-x="76" default-y="-92" justify="left" valign="middle" font-style="italic" font-size="8.8671" font-weight="normal">40 note series from middle C to high C 3 octaves up. Repeated notes are rests. We need 8va and 8vb added automatically.</words>
    </direction-type>
    <voice>1</voice>
    <staff>1</staff>
   </direction>
   <direction>
    <direction-type>
     <words default-x="32" default-y="121" justify="left" valign="middle" font-style="normal" font-size="8.8671" font-weight="bold">Starburst</words>
     <words justify="left" valign="middle" font-style="normal" font-size="8.8671" font-weight="normal">. Play dramatically in free time. Eight notes are freely fast, rests are approximate. </words>
     <words justify="left" valign="middle" font-style="normal" font-size="8.8671" font-weight="normal">Dynamics follow motion between </words>
     <words justify="left" valign="middle" font-style="normal" font-size="8.8671" font-weight="bold">pp</words>
     <words justify="left" valign="middle" font-style="normal" font-size="8.8671" font-weight="normal"> and </words>
     <words justify="left" valign="middle" font-style="normal" font-size="8.8671" font-weight="bold">ff. </words>
     <words justify="left" valign="middle" font-style="normal" font-size="8.8671" font-weight="normal">Refresh pedal as needed.</words>
    </direction-type>
    <voice>1</voice>
    <staff>1</staff>
   </direction>
